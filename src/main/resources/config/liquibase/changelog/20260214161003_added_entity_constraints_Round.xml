    <!--
        Added the constraints for entity Round.
    -->
    <changeSet id="20260214161003-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="tenant_id"
                                 baseTableName="round"
                                 constraintName="fk_round__tenant_id"
