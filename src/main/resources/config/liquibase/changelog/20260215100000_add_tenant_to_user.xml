<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Add tenant_id to jhi_user table and link to existing tenant
    -->
    <changeSet id="20260215100000-1" author="system">
        <!-- Create default tenant only if no tenants exist -->
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM tenant</sqlCheck>
        </preConditions>
        <insert tableName="tenant">
            <column name="id" valueNumeric="1"/>
            <column name="code" value="TEN-0001"/>
            <column name="name" value="Default"/>
            <column name="email" value="admin@localhost"/>
            <column name="active" valueBoolean="true"/>
        </insert>
    </changeSet>

    <changeSet id="20260215100000-2" author="system">
        <!-- Add tenant_id column to jhi_user -->
        <addColumn tableName="jhi_user">
            <column name="tenant_id" type="bigint">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="20260215100000-3" author="system">
        <!-- Link existing users to the first tenant in the database -->
        <sql>UPDATE jhi_user SET tenant_id = (SELECT MIN(id) FROM tenant) WHERE tenant_id IS NULL</sql>
    </changeSet>

    <changeSet id="20260215100000-4" author="system">
        <!-- Make tenant_id required and add foreign key -->
        <addNotNullConstraint tableName="jhi_user" columnName="tenant_id" columnDataType="bigint"/>
        <addForeignKeyConstraint
            baseTableName="jhi_user"
            baseColumnNames="tenant_id"
            constraintName="fk_user_tenant"
            referencedTableName="tenant"
            referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="20260215100000-5a" author="system">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM jhi_authority WHERE name = 'ROLE_TENANT_ADMIN'</sqlCheck>
        </preConditions>
        <insert tableName="jhi_authority">
            <column name="name" value="ROLE_TENANT_ADMIN"/>
        </insert>
    </changeSet>

    <changeSet id="20260215100000-5b" author="system">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM jhi_authority WHERE name = 'ROLE_MANAGER'</sqlCheck>
        </preConditions>
        <insert tableName="jhi_authority">
            <column name="name" value="ROLE_MANAGER"/>
        </insert>
    </changeSet>

    <changeSet id="20260215100000-5c" author="system">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM jhi_authority WHERE name = 'ROLE_ACCOUNTANT'</sqlCheck>
        </preConditions>
        <insert tableName="jhi_authority">
            <column name="name" value="ROLE_ACCOUNTANT"/>
        </insert>
    </changeSet>

    <changeSet id="20260215100000-5d" author="system">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM jhi_authority WHERE name = 'ROLE_DRIVER'</sqlCheck>
        </preConditions>
        <insert tableName="jhi_authority">
            <column name="name" value="ROLE_DRIVER"/>
        </insert>
    </changeSet>

</databaseChangeLog>
