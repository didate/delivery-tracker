<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Expense.
    -->
    <changeSet id="20260214161009-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="tenant_id"
                                 baseTableName="expense"
                                 constraintName="fk_expense__tenant_id"
                                 referencedColumnNames="id"
                                 referencedTableName="tenant"
                                 />

        <addForeignKeyConstraint baseColumnNames="category_id"
                                 baseTableName="expense"
                                 constraintName="fk_expense__category_id"
                                 referencedColumnNames="id"
                                 referencedTableName="expense_category"
                                 />

        <addForeignKeyConstraint baseColumnNames="driver_id"
                                 baseTableName="expense"
                                 constraintName="fk_expense__driver_id"
                                 referencedColumnNames="id"
                                 referencedTableName="driver"
                                 />
    </changeSet>
</databaseChangeLog>
